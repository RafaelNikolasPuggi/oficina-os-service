# Aplicação
PORT=3000
NODE_ENV=development

# JWT (compartilhado com os demais serviços e com a oficina-lambda-auth via SSM Parameter Store)
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=1h

# Banco de dados (PostgreSQL — exclusivo deste serviço: clientes, veiculos, ordens-servico)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oficina_os
DB_PASSWORD=oficina_os
DB_DATABASE=oficina_os

# Serviço de produção (catálogo de serviços/peças e estoque) — Fase 4
PRODUCAO_SERVICE_URL=http://localhost:3001

# E-mail (notificação de mudança de status da OS)
# Local/dev: aponta para o Mailhog do docker-compose (captura tudo, sem enviar de verdade).
# UI do Mailhog: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=oficina@example.com

# Usuário administrativo inicial (usado pelo script npm run seed:admin)
ADMIN_EMAIL=admin@oficina.com
ADMIN_PASSWORD=admin123
ADMIN_NOME=Administrador

# Observabilidade (New Relic, mesma conta da Fase 3) — desligado por padrão em dev local/CI.
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-os-service
